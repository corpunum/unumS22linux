# firmware blobs / large binaries - never commit
stock/**/*.img
stock/**/*.tar*
stock/**/*.md5
lineage/**/*.img
builds/**
*.tar
*.tar.md5
*.img
*.zip

# nested repos (cloned sources, not submodules)
/lineage/android_device_samsung_r0s/
/lineage/android_device_samsung_s5e9925-common/
/lineage/android_kernel_samsung_s5e9925/
/tools/avb/
/tools/mkbootimg/
/tools/samloader/

# large binary artifacts (kept on disk, not in git)
lineage/build-*/unpacked/
lineage/build-*/*.img
evidence/**/*.img
evidence/**/*.bin
rollback/**/*.bin

# Samsung stock firmware (extracted proprietary binaries) - never publish these,
# copyright/redistribution risk, not our code. Kept on disk, never in git.
/stock/
/lineage/build-*/

# ramdisk staging directories - full copies of Samsung's extracted ramdisk tree
# plus busybox binary and .ko files; large, and same firmware-provenance concern
# as /stock/ above. Only the cinit*.c sources (tracked separately) are ours.
/initramfs/nativev*/
/initramfs/cinit
/initramfs/cinit[0-9]*
!/initramfs/cinit*.c

# cloned busybox build tree (GPL source, but large and not our code)
/tools/busybox/

# Native Linux build roots and private device backups stay on this workstation.
/rootfs/
/tools/omarchy-trial/omarchy-source/
/tools/omarchy-trial/radv-*/
evidence/**/*.tar.gz
evidence/**/*.tar.xz

# Generated caches, native libraries, downloaded packages and build roots.
__pycache__/
*.py[cod]
*.tar.gz
*.tar.xz
*.tar.zst
*.tgz
*.pkg.tar.*
*.so
*.so.*
*.o
*.a
/tools/gpu-compute-probe/gpu-compute-probe
/tools/gpu-compute-probe/*-aarch64-musl
*.spv
/tools/omarchy-trial/aquamarine-s22-source/
/tools/omarchy-trial/omarchy-ui-candidate/package-delta/
/tools/omarchy-trial/omarchy-ui-candidate/shell/

# Full upstream references stay local; publish the small pinned patches.
/tools/omarchy-trial/aquamarine-*.cpp
/tools/omarchy-trial/hyprland-*.cpp

# Raw recovery forensics and private material are not public project evidence.
/evidence/native-linux-20260919/preflight/cache-recovery/
/evidence/native-linux-20260919/preflight/boot_reset.txt
/evidence/native-linux-20260919/native-first-no-ack/linux-state.txt
/evidence/native-linux-20260919/native-first-no-ack/host-dmesg-after-fallback.txt
**/*private-key*
**/id_ed25519
**/id_rsa
**/ssh_host_*_key
**/.env
**/.env.*

# Device/account identities belong in local provisioning, not public evidence.
**/known_hosts
**/*known-hosts
**/tailscaled.state
**/tailscale/private/
**/wpa_supplicant*.conf
**/*auth-url*
