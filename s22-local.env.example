# s22-local.env.example: per-install addresses that are NOT in the code.
#
# The repo never holds real tailnet / LAN addresses. Copy this file, fill in your own values and keep
# the copy untracked (mode 600). The format is plain KEY=VALUE: it is read by sh (sourced or sed),
# by Python (s22_rigvoice.py, npu-accept, s22-trace-summary.py) and by systemd (EnvironmentFile=).
# A variable set in the environment always wins over the file.
#
# 1. On the rig / host (the machine that drives the phone):
#      mkdir -p ~/.config/s22-linux && cp s22-local.env.example ~/.config/s22-linux/local.env
#      chmod 600 ~/.config/s22-linux/local.env      # then edit
#    Read by: tools/hardware/voice/install-voice.sh, tools/hardware/npu/npu-accept,
#             tools/hardware/power/s22-trace-summary.py (S22_PHONE_HOST) and the rig voice units
#             s22-whisper.service / s22-voxcpm-tailnet.service (S22_RIG_HOST, the address they bind).
#    tools/hardware/voice/rig/install-rig.sh writes S22_RIG_HOST from `tailscale ip -4` when it is missing.
#    S22_LOCAL_ENV=/path/to/file names another file.
#
# 2. On the phone: /srv/s22/state/local.env (only S22_RIG_HOST is used there)
#    Read by: s22_rigvoice.py (rig TTS http://RIG:8890 and ASR http://RIG:8891, unless
#             /srv/s22/state/rigvoice.json sets tts_url / asr_url) and s22-power-health.sh (tailscale ping).
#    Without it the rig voice counts as unavailable and the phone's own fallbacks speak.
#
# 3. OpenUnum on the phone: tools/openunum-phone/openunum.json is a template; replace RIG_TAILNET_IP in
#    model.llamaCppLocalBaseUrl with the rig's address in the phone's copy (/root/.openunum/openunum.json).

# ssh target of the phone, e.g. root@<phone tailnet IP or MagicDNS name>
S22_PHONE_HOST=
# the rig's Tailscale address (or MagicDNS name) that the phone talks to
S22_RIG_HOST=
