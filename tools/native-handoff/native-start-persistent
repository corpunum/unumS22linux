#!/system/bin/sh
# Optional recovery-side native userspace setup with cache-backed OverlayFS.
# This is deliberately separate from native-start: the proven RAM-only path
# remains unchanged and is the fallback when cache or overlay setup fails.

set -u
BB=/system/bin/toybox
LOG=/native/handoff.log
PATH=/native/bin:/system/bin:/system/xbin:/sbin:/bin:/usr/sbin:/usr/bin
export PATH

log() {
    printf 'native-start-persistent: %s\n' "$*" >> "$LOG" 2>/dev/null || true
    printf 'native-start-persistent: %s\n' "$*" > /dev/kmsg 2>/dev/null || true
}
die() { log "FATAL: $*"; exit 1; }

ensure_dir() {
    if [ -L "$1" ]; then die "refusing symlink mount target $1"; fi
    if [ -e "$1" ]; then [ -d "$1" ] || die "$1 exists and is not a directory"; return; fi
    mkdir -p "$1" || die "mkdir $1 failed"
}

safe_dir() {
    if [ -L "$1" ]; then log "refusing symlink persistence path $1"; return 1; fi
    if [ -e "$1" ]; then [ -d "$1" ] || return 1; return 0; fi
    mkdir -p "$1" || return 1
}

mounted() {
    "$BB" mountpoint -q "$1" 2>/dev/null && return 0
    [ -r /proc/mounts ] || return 1
    target=$1
    while IFS=' ' read -r source mount_target rest; do
        [ "$mount_target" = "$target" ] && return 0
    done < /proc/mounts
    return 1
}

make_node() {
    path=$1; kind=$2; major=$3; minor=$4
    [ -e "$path" ] && return 0
    ensure_dir "${path%/*}"
    "$BB" mknod -m 0600 "$path" "$kind" "$major" "$minor" || \
        die "mknod $path failed"
}

scan_devices() {
    # Recovery first-stage skips AOSP DoCreateDevices. Run mdev when present,
    # then always derive by-name aliases from kernel PARTNAME metadata.
    if "$BB" mdev -s >/dev/null 2>&1; then
        log "device scan used toybox mdev -s"
    else
        for kind in char block; do
            for entry in /sys/dev/$kind/*; do
                [ -r "$entry/uevent" ] || continue
                major= minor= name=
                while IFS='=' read -r key value; do
                    case "$key" in
                        MAJOR) major=$value ;;
                        MINOR) minor=$value ;;
                        DEVNAME) name=$value ;;
                    esac
                done < "$entry/uevent"
                [ -n "$major" ] && [ -n "$minor" ] && [ -n "$name" ] || continue
                case "$name" in *..*|/*) continue ;; esac
                path=/dev/$name
                [ -e "$path" ] || {
                    ensure_dir "${path%/*}"
                    "$BB" mknod -m 0600 "$path" "$([ "$kind" = char ] && echo c || echo b)" \
                        "$major" "$minor" 2>>"$LOG" || true
                }
                if [ "$kind" = block ]; then
                    ensure_dir /dev/block
                    [ -e "/dev/block/$name" ] || \
                        "$BB" ln -s "../$name" "/dev/block/$name" 2>>"$LOG" || true
                fi
            done
        done
        log "device scan used generic /sys/dev/{char,block} uevents"
    fi

    ensure_dir /dev/block
    ensure_dir /dev/block/by-name
    for entry in /sys/dev/block/*; do
        [ -r "$entry/uevent" ] || continue
        name= partname=
        while IFS='=' read -r key value; do
            case "$key" in
                DEVNAME) name=$value ;;
                PARTNAME) partname=$value ;;
            esac
        done < "$entry/uevent"
        [ -n "$name" ] && [ -n "$partname" ] || continue
        case "$name" in *..*|/*) continue ;; esac
        case "$partname" in *[!A-Za-z0-9._+-]*) continue ;; esac
        if [ ! -e "/dev/$name" ] && [ ! -e "/dev/block/$name" ]; then
            continue
        fi
        [ -e "/dev/block/$name" ] || \
            "$BB" ln -s "../$name" "/dev/block/$name" 2>>"$LOG" || true
        [ -e "/dev/block/$name" ] || continue
        alias=/dev/block/by-name/$partname
        if [ ! -e "$alias" ]; then
            "$BB" ln -s "../$name" "$alias" 2>>"$LOG" || true
            [ -e "$alias" ] && log "partition alias $partname -> $name"
        fi
    done
}

setup_base_mounts() {
    ensure_dir /proc
    mounted /proc || "$BB" mount -t proc proc /proc || die "proc mount failed"
    ensure_dir /sys
    mounted /sys || "$BB" mount -t sysfs sysfs /sys || die "sysfs mount failed"
    ensure_dir /config
    mounted /config || "$BB" mount -t configfs configfs /config || die "configfs mount failed"
    ensure_dir /dev
    scan_devices
    make_node /dev/null c 1 3
    make_node /dev/kmsg c 1 11
    make_node /dev/watchdog c 10 130
    make_node /dev/console c 5 1
}

prepare_lower() {
    ensure_dir /native-lower
    if mounted /native-lower; then return 0; fi
    "$BB" mount -t tmpfs -o mode=0755,size=1G native-lower /native-lower || \
        die "RAM lower mount failed"
    [ -f /native/rootfs.tar.xz ] || die "embedded xz rootfs not found"
    /native/lib/ld-musl-aarch64.so.1 /native/bin/busybox unxz -c \
        /native/rootfs.tar.xz | "$BB" tar -xf - -C /native-lower || \
        die "xz rootfs extraction failed"
}

prepare_cache_workspace() {
    # This is the only persistent source permitted here. It must have been
    # created from PARTNAME=cache by scan_devices; no sdaN fallback exists.
    cache_device=/dev/block/by-name/cache
    [ -e "$cache_device" ] || { log "cache PARTNAME alias is absent"; return 1; }
    [ -L "$cache_device" ] || { log "cache alias is not a symlink"; return 1; }
    [ -b "$cache_device" ] || { log "cache alias is not a block device"; return 1; }
    ensure_dir /cache
    if ! mounted /cache; then
        "$BB" mount -t ext4 -o rw "$cache_device" /cache || {
            log "cache ext4 mount failed; continuing RAM-only"
            return 1
        }
    else
        cache_real=$(
            "$BB" readlink -f "$cache_device" 2>/dev/null || true
        )
        cache_name=${cache_real##*/}
        cache_mount_ok=0
        while IFS=' ' read -r source mount_target rest; do
            [ "$mount_target" = /cache ] || continue
            case "$source" in
                "$cache_device"|"$cache_real"|"/dev/$cache_name"|"/dev/block/$cache_name")
                    cache_mount_ok=1
                    ;;
            esac
            break
        done < /proc/mounts
        if [ "$cache_mount_ok" -ne 1 ]; then
            log "refusing unexpected existing /cache mount; continuing RAM-only"
            return 1
        fi
        log "using existing /cache mount from PARTNAME=cache"
    fi
    safe_dir /cache/s22-linux || { log "cache persistence root is unusable"; return 1; }
    safe_dir /cache/s22-linux/upper || { log "cache upper is unusable"; return 1; }
    safe_dir /cache/s22-linux/work || { log "cache work is unusable"; return 1; }
    chmod 0755 /cache/s22-linux/upper || {
        log "cache persistence root permissions failed"
        return 1
    }
    chmod 0700 /cache/s22-linux /cache/s22-linux/work || {
        log "cache persistence permissions failed"
        return 1
    }
    return 0
}

prepare_root() {
    ensure_dir /newroot
    if mounted /newroot; then
        PERSIST_MODE=existing
        return 0
    fi
    if prepare_cache_workspace; then
        options=lowerdir=/native-lower,upperdir=/cache/s22-linux/upper,workdir=/cache/s22-linux/work
        if "$BB" mount -t overlay overlay -o "$options" /newroot; then
            PERSIST_MODE=overlay
            log "cache-backed OverlayFS root active at /cache/s22-linux"
        else
            log "OverlayFS mount failed; continuing with RAM-only root"
        fi
    else
        log "persistent cache unavailable; continuing with RAM-only root"
    fi
    if ! mounted /newroot; then
        "$BB" mount --bind /native-lower /newroot || die "RAM root bind failed"
        "$BB" mount --make-rslave /newroot 2>/dev/null || true
        PERSIST_MODE=ram
    fi
}

bind_tree() {
    src=$1; dst=$2
    ensure_dir "$dst"
    mounted "$dst" || "$BB" mount --rbind "$src" "$dst" || \
        "$BB" mount --bind "$src" "$dst" || die "bind $src -> $dst failed"
    "$BB" mount --make-rslave "$dst" 2>/dev/null || true
}

configure_gadget() {
    G=/config/usb_gadget/g1
    C=$G/configs/b.1
    UDC=10b00000.dwc3
    if [ -e "$G" ]; then die "refusing to take over existing USB gadget $G"; fi
    : > /run/native-gadget-owned || die "cannot create gadget ownership marker"
    mkdir -p "$G/strings/0x409" "$C/strings/0x409" || die "gadget directories failed"
    printf '%s\n' 0x1d6b > "$G/idVendor"
    printf '%s\n' 0x0104 > "$G/idProduct"
    printf '%s\n' 0x0100 > "$G/bcdDevice"
    printf '%s\n' 0x0200 > "$G/bcdUSB"
    printf '%s\n' S22-native > "$G/strings/0x409/serialnumber"
    printf '%s\n' unumS22linux > "$G/strings/0x409/manufacturer"
    printf '%s\n' native-linux > "$G/strings/0x409/product"
    printf '%s\n' native-ecm > "$C/strings/0x409/configuration"
    printf '%s\n' 120 > "$C/MaxPower"
    mkdir "$G/functions/ecm.usb0" || die "ECM function creation failed"
    printf '%s\n' 02:73:22:00:00:02 > "$G/functions/ecm.usb0/dev_addr"
    printf '%s\n' 02:73:22:00:00:01 > "$G/functions/ecm.usb0/host_addr"
    printf '%s\n' 'ecm%d' > "$G/functions/ecm.usb0/ifname"
    ln -s "$G/functions/ecm.usb0" "$C/f1" || die "ECM config link failed"
    printf '%s\n' "$UDC" > "$G/UDC" || die "UDC bind failed"
    log "ECM gadget bound to $UDC"
}

configure_network() {
    chroot /newroot /sbin/ip link set lo up || die "loopback setup failed"
    chroot /newroot /sbin/ip link set ecm0 up || die "ecm0 link setup failed"
    chroot /newroot /sbin/ip addr replace 10.55.0.2/24 dev ecm0 || die "ECM address failed"
    chroot /newroot /sbin/ip route replace 10.55.0.0/24 dev ecm0 || die "ECM route failed"
    chroot /newroot /sbin/ip route replace default via 10.55.0.1 dev ecm0 || die "default route failed"
    printf '%s\n' 'nameserver 10.55.0.1' > /newroot/etc/resolv.conf || die "DNS setup failed"
}

finish_root() {
    for tree in dev proc sys run; do
        ensure_dir "/newroot/$tree"
        bind_tree "/$tree" "/newroot/$tree"
    done
    ensure_dir /newroot/tmp
    mounted /newroot/tmp || \
        "$BB" mount -t tmpfs -o mode=1777,size=256M native-tmp /newroot/tmp || \
        die "native tmpfs mount failed"
    ensure_dir /newroot/native
    bind_tree /native /newroot/native
    "$BB" mount -o remount,bind,ro /newroot/native 2>>"$LOG" || \
        log "native log bind could not be remounted read-only"
    ensure_dir /run/sshd
    if [ ! -f /newroot/etc/ssh/ssh_host_ed25519_key ]; then
        chroot /newroot /usr/bin/ssh-keygen -A || die "host key generation failed"
    fi
    chroot /newroot /bin/hostname s22-linux || die "hostname setup failed"
}

write_storage_mode() {
    ensure_dir /run
    printf '%s\n' "$PERSIST_MODE" > /run/native-storage-mode || \
        die "native storage mode marker failed"
}

start_gui() {
    [ -x /newroot/usr/local/bin/start-weston-native ] || return 0
    ensure_dir /run
    chroot /newroot /bin/sh -c 'exec /usr/local/bin/start-weston-native' \
        </dev/null >>/run/weston-native.log 2>&1 &
    log "started optional Weston GUI pid=$!"
}

if [ "${1:-}" = resume ]; then
    log "resuming SSH rescue"
    [ -x /newroot/usr/sbin/sshd ] || die "native root is not prepared"
    exec chroot /newroot /usr/sbin/sshd -D -e
fi

PERSIST_MODE=ram
setup_base_mounts
prepare_lower
prepare_root
configure_gadget
finish_root
configure_network
write_storage_mode
start_gui
log "native root extracted; mode=$PERSIST_MODE; SSH starting"
exec chroot /newroot /usr/sbin/sshd -D -e
