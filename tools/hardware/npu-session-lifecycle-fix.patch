@@ -43,6 +49,195 @@ struct npu_frame kpi_frame[KPI_FRAME_MAX_BUFFER];
 #define KPI_FRAME_PRIORITY	200
 const struct npu_session_ops npu_session_ops;
 
+#ifdef CONFIG_NPU_USE_BOOT_IOCTL
+#define NPU_POWER_WAIT_TIMEOUT_MS	12000
+
+/* POWER_CTL is not linked to a protodrv session reference.  Its callback
+ * therefore carries a monotonically unique cookie instead of a session
+ * pointer.  The cookie is looked up under this lock before any waiter state
+ * is touched; late and duplicate callbacks become no-ops.
+ */
+struct npu_power_waiter {
+	struct list_head	list;
+	u64			cookie;
+	npu_req_id_t		req_id;
+	struct completion	completion;
+	struct nw_result	result;
+	bool			done;
+};
+
+static LIST_HEAD(npu_power_waiters);
+static DEFINE_SPINLOCK(npu_power_waiters_lock);
+static atomic64_t npu_power_wait_cookie = ATOMIC64_INIT(0);
+
+static struct npu_power_waiter *npu_power_waiter_find(u64 cookie)
+{
+	struct npu_power_waiter *waiter;
+
+	list_for_each_entry(waiter, &npu_power_waiters, list) {
+		if (waiter->cookie == cookie)
+			return waiter;
+	}
+	return NULL;
+}
+
+int npu_session_save_power_result(struct npu_session *session, struct nw_result result)
+{
+	struct npu_power_waiter *waiter;
+	unsigned long flags;
+	u64 cookie = ((u64)result.nw.param1 << 32) | result.nw.param0;
+
+	/* The session argument is deliberately not dereferenced: the waiter is
+	 * identified by the opaque cookie copied through POWER_CTL's unused params.
+	 */
+	(void)session;
+
+	spin_lock_irqsave(&npu_power_waiters_lock, flags);
+	waiter = npu_power_waiter_find(cookie);
+	if (waiter && waiter->req_id &&
+	    waiter->req_id == result.nw.npu_req_id && !waiter->done) {
+		waiter->result = result;
+		waiter->done = true;
+		complete(&waiter->completion);
+	}
+	spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+	return 0;
+}
+
+int npu_session_power_wait_assign_req_id(u64 cookie, npu_req_id_t req_id)
+{
+	struct npu_power_waiter *waiter;
+	unsigned long flags;
+	int ret = -ECANCELED;
+
+	if (!cookie || !req_id)
+		return -EINVAL;
+	spin_lock_irqsave(&npu_power_waiters_lock, flags);
+	waiter = npu_power_waiter_find(cookie);
+	if (waiter && !waiter->done && !waiter->req_id) {
+		waiter->req_id = req_id;
+		ret = 0;
+	} else if (waiter && waiter->req_id) {
+		ret = -EALREADY;
+	}
+	spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+	return ret;
+}
+
+int npu_session_power_wait_is_active(u64 cookie, npu_req_id_t req_id)
+{
+	struct npu_power_waiter *waiter;
+	unsigned long flags;
+	int active = 0;
+
+	spin_lock_irqsave(&npu_power_waiters_lock, flags);
+	waiter = npu_power_waiter_find(cookie);
+	if (waiter && waiter->req_id == req_id && !waiter->done)
+		active = 1;
+	spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+	return active;
+}
+
+static int npu_power_result_to_errno(npu_errno_t result)
+{
+	if (result == NPU_ERR_NO_ERROR)
+		return 0;
+
+	switch (NPU_ERR_CODE(result)) {
+	case NPU_ERR_NPU_TIMEOUT:
+	case NPU_ERR_QUEUE_TIMEOUT:
+	case NPU_ERR_SCHED_TIMEOUT:
+	case NPU_ERR_NPU_HW_TIMEOUT_RECOVERED:
+	case NPU_ERR_NPU_HW_TIMEOUT_NOTRECOVERABLE:
+		return -ETIMEDOUT;
+	case NPU_ERR_NO_MEMORY:
+		return -ENOMEM;
+	case NPU_ERR_INVALID_UID:
+		return -ENOENT;
+	case NPU_ERR_INVALID_STATE:
+	case NPU_ERR_SIZE_NOT_MATCH:
+		return -EINVAL;
+	default:
+		return -EIO;
+	}
+}
+
+/* Caller holds session->global_lock.  npu_session_close takes the same lock
+ * before setting CLOSE, so teardown cannot free the session while this stack
+ * waiter is registered or while it is copying its result.
+ */
+static int npu_session_wait_power_request(struct npu_session *session, nw_cmd_e nw_cmd)
+{
+	struct npu_power_waiter waiter;
+	struct npu_nw req = { };
+	unsigned long flags;
+	unsigned long waited;
+	unsigned long timeout;
+	int queued, ret;
+
+	memset(&waiter, 0, sizeof(waiter));
+	INIT_LIST_HEAD(&waiter.list);
+	init_completion(&waiter.completion);
+	for (;;) {
+		waiter.cookie = atomic64_inc_return(&npu_power_wait_cookie);
+		spin_lock_irqsave(&npu_power_waiters_lock, flags);
+		if (waiter.cookie && !npu_power_waiter_find(waiter.cookie))
+			break;
+		spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+	}
+
+	req.uid = session->uid;
+	req.bound_id = session->sched_param.bound_id;
+	req.npu_req_id = 0;
+	req.result_code = 0;
+	/* POWER_CTL is not session-ref linked and has no session-lifetime need.
+	 * Keep the pointer NULL so delayed protocol work cannot dereference a
+	 * session after its bounded waiter times out and close frees it.  A NULL
+	 * session selects the general message-ID pool; POWER_CTL's wire mapping
+	 * ignores these unused parameters.
+	 */
+	req.session = NULL;
+	req.param0 = (u32)waiter.cookie;
+	req.param1 = (u32)(waiter.cookie >> 32);
+	req.cmd = nw_cmd;
+	req.ncp_addr = session->ncp_info.ncp_addr;
+	req.magic_tail = NPU_NW_MAGIC_TAIL;
+	req.notify_func = npu_session_save_power_result;
+	session->nw_result.result_code = NPU_NW_JUST_STARTED;
+
+	list_add_tail(&waiter.list, &npu_power_waiters);
+	spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+
+	queued = npu_ncp_mgmt_put(&req);
+	if (unlikely(queued <= 0)) {
+		spin_lock_irqsave(&npu_power_waiters_lock, flags);
+		if (!list_empty(&waiter.list))
+			list_del_init(&waiter.list);
+		spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+		ret = queued < 0 ? queued : -EAGAIN;
+		session->nw_result.result_code = NPU_ERR_DRIVER(NPU_ERR_INVALID_STATE);
+		session->nw_result.nw.npu_req_id = 0;
+		return ret;
+	}
+
+	timeout = msecs_to_jiffies(NPU_POWER_WAIT_TIMEOUT_MS);
+	waited = wait_for_completion_timeout(&waiter.completion, timeout);
+	spin_lock_irqsave(&npu_power_waiters_lock, flags);
+	if (waiter.done) {
+		session->nw_result = waiter.result;
+		ret = npu_power_result_to_errno(waiter.result.result_code);
+	} else {
+		ret = waited ? -EIO : -ETIMEDOUT;
+		session->nw_result.result_code = NPU_ERR_DRIVER(NPU_ERR_NPU_TIMEOUT);
+		session->nw_result.nw.npu_req_id = 0;
+	}
+	if (!list_empty(&waiter.list))
+		list_del_init(&waiter.list);
+	spin_unlock_irqrestore(&npu_power_waiters_lock, flags);
+	return ret;
+}
+#endif
+
