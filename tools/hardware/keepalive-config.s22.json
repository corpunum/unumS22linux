{
  "services": [
    "openunum",
    "unumsearch",
    "modem",
    "phoned",
    "llama"
  ],
  "pin_model": true,
  "pin": {
    "provider": "openai",
    "model": "openai/gpt-6-luna"
  },
  "service_defs": {
    "llama": {
      "argv": [
        "/usr/bin/python3",
        "/srv/s22/hardware/bin/s22-gpu-exec-isolated",
        "/srv/s22/gpu-compat-20260921/llama-vulkan",
        "--bridge-v4",
        "/system/bin/llama-server",
        "-m",
        "/models/Qwen3.5-2B-Q4_0.gguf",
        "-ngl",
        "99",
        "-t",
        "4",
        "-c",
        "16384",
        "-np",
        "1",
        "-fa",
        "on",
        "--cache-ram",
        "0",
        "--host",
        "127.0.0.1",
        "--port",
        "8090",
        "--reasoning",
        "off",
        "--no-webui"
      ],
      "needle": "llama-server -m /models/Qwen3.5-2B-Q4_0.gguf",
      "health": {
        "http": "http://127.0.0.1:8090/health"
      },
      "requires": "/srv/s22/gpu-compat-20260921/llama-vulkan/system/bin/llama-server",
      "log": "/srv/s22/state/llama-gpu-8090.log",
      "start_wait_s": 120,
      "unhealthy_s": 600
    }
  }
}