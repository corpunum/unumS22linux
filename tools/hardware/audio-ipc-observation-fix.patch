@@ -0,0 +1,108 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#undef TRACE_SYSTEM
+#define TRACE_SYSTEM samsung_abox
+
+#if !defined(_TRACE_SAMSUNG_ABOX_H) || defined(TRACE_HEADER_MULTI_READ)
+#define _TRACE_SAMSUNG_ABOX_H
+
+#include <linux/tracepoint.h>
+
+/*
+ * These events contain only routing/result metadata. In particular, they do
+ * not copy or print ABOX messages, DMA pointers, firmware data, or device
+ * pointers. The generated tracepoints are disabled until explicitly enabled.
+ */
+TRACE_EVENT(abox_pcm_trigger_queue,
+	TP_PROTO(u64 sequence, u64 mono_ns, int ipc_id, int channel,
+		int msg_type, int result, int attempt, bool atomic, bool sync),
+
+	TP_ARGS(sequence, mono_ns, ipc_id, channel, msg_type, result, attempt,
+		atomic, sync),
+
+	TP_STRUCT__entry(
+		__field(u64, sequence)
+		__field(u64, mono_ns)
+		__field(int, ipc_id)
+		__field(int, channel)
+		__field(int, msg_type)
+		__field(int, result)
+		__field(int, attempt)
+		__field(bool, atomic)
+		__field(bool, sync)
+	),
+
+	TP_fast_assign(
+		__entry->sequence = sequence;
+		__entry->mono_ns = mono_ns;
+		__entry->ipc_id = ipc_id;
+		__entry->channel = channel;
+		__entry->msg_type = msg_type;
+		__entry->result = result;
+		__entry->attempt = attempt;
+		__entry->atomic = atomic;
+		__entry->sync = sync;
+	),
+
+	TP_printk("seq=%llu mono_ns=%llu ipc_id=%d channel=%d msg_type=%d result=%d attempt=%d atomic=%d sync=%d",
+		(unsigned long long)__entry->sequence,
+		(unsigned long long)__entry->mono_ns, __entry->ipc_id,
+		__entry->channel, __entry->msg_type, __entry->result,
+		__entry->attempt, __entry->atomic, __entry->sync)
+);
+
+TRACE_EVENT(abox_pcm_trigger_send,
+	TP_PROTO(u64 sequence, u64 mono_ns, int ipc_id, int channel,
+		int msg_type, int result),
+
+	TP_ARGS(sequence, mono_ns, ipc_id, channel, msg_type, result),
+
+	TP_STRUCT__entry(
+		__field(u64, sequence)
+		__field(u64, mono_ns)
+		__field(int, ipc_id)
+		__field(int, channel)
+		__field(int, msg_type)
+		__field(int, result)
+	),
+
+	TP_fast_assign(
+		__entry->sequence = sequence;
+		__entry->mono_ns = mono_ns;
+		__entry->ipc_id = ipc_id;
+		__entry->channel = channel;
+		__entry->msg_type = msg_type;
+		__entry->result = result;
+	),
+
+	TP_printk("seq=%llu mono_ns=%llu ipc_id=%d channel=%d msg_type=%d result=%d",
+		(unsigned long long)__entry->sequence,
+		(unsigned long long)__entry->mono_ns, __entry->ipc_id,
+		__entry->channel, __entry->msg_type, __entry->result)
+);
+
+TRACE_EVENT(abox_rdma_pointer_handler,
+	TP_PROTO(u64 mono_ns, int channel, int msg_type),
+
+	TP_ARGS(mono_ns, channel, msg_type),
+
+	TP_STRUCT__entry(
+		__field(u64, mono_ns)
+		__field(int, channel)
+		__field(int, msg_type)
+	),
+
+	TP_fast_assign(
+		__entry->mono_ns = mono_ns;
+		__entry->channel = channel;
+		__entry->msg_type = msg_type;
+	),
+
+	TP_printk("mono_ns=%llu channel=%d msg_type=%d",
+		(unsigned long long)__entry->mono_ns, __entry->channel,
+		__entry->msg_type)
+);
+
+#endif /* _TRACE_SAMSUNG_ABOX_H */
+
+/* This part must be outside protection */
+#include <trace/define_trace.h>
