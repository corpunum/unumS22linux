 static inline int npu_hw_ref_put(
 		struct npu_device *device, struct npu_hw_refcount *hw_ref)
 {
+	int count, ret = 0;
+
+	if (!hw_ref->final)
+		return 0;
+
+	mutex_lock(&hw_ref->lock);
+	if (hw_ref->failure) {
+		ret = hw_ref->failure;
+		goto out;
+	}
+
+	count = atomic_read(&hw_ref->refcount);
+	if (count <= 0) {
+		ret = -EINVAL;
+		goto out;
+	}
+	if (count > 1) {
+		atomic_set(&hw_ref->refcount, count - 1);
+		goto out;
+	}
+
+	/* Keep the last owner published if teardown fails; never retry it. */
+	ret = hw_ref->final(device, hw_ref->hdev);
+	if (ret)
+		hw_ref->failure = ret;
+	else
+		atomic_set(&hw_ref->refcount, 0);
+out:
+	mutex_unlock(&hw_ref->lock);
+	return ret;
