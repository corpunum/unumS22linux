+	ret = hw_ref->abort(device, hw_ref->hdev);
+	if (ret)
+		hw_ref->failure = ret;
+	else
+		atomic_set(&hw_ref->refcount, 0);
+out:
+	mutex_unlock(&hw_ref->lock);
+	return ret;
 }
 
