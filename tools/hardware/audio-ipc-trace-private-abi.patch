 #include <linux/sched/clock.h>
+#include <linux/rcupdate.h>
 
 #include <sound/soc.h>
 #include <sound/soc-dapm.h>
@@ -82,6 +83,123 @@
 #define IPC_RETRY			(10)
 static atomic64_t abox_pcm_trigger_trace_seq = ATOMIC64_INIT(0);
 
+struct abox_ipc_trace_owner {
+	struct abox_ipc_trace_owner __rcu *next;
+	struct abox_data *data;
+	u64 trace_seq[ABOX_IPC_QUEUE_SIZE];
+	bool registered;
+};
+
+static struct abox_ipc_trace_owner __rcu *abox_ipc_trace_owner_head;
+static DEFINE_SPINLOCK(abox_ipc_trace_owner_lock);
+
+/* Caller holds rcu_read_lock() while using the returned owner. */
+static struct abox_ipc_trace_owner *
+abox_ipc_trace_owner_find(struct abox_data *data)
+{
+	struct abox_ipc_trace_owner *owner;
+
+	owner = rcu_dereference(abox_ipc_trace_owner_head);
+	while (owner) {
+		if (owner->data == data)
+			return owner;
+		owner = rcu_dereference(owner->next);
+	}
+
+	return NULL;
+}
+
+/* Caller holds abox_ipc_trace_owner_lock. */
+static bool abox_ipc_trace_owner_unlink_locked(
+		struct abox_ipc_trace_owner *target)
+{
+	struct abox_ipc_trace_owner __rcu **link =
+		&abox_ipc_trace_owner_head;
+	struct abox_ipc_trace_owner *owner;
+
+	while ((owner = rcu_dereference_protected(*link, 1))) {
+		if (owner == target) {
+			rcu_assign_pointer(*link,
+					rcu_access_pointer(owner->next));
+			owner->registered = false;
+			return true;
+		}
+		link = &owner->next;
+	}
+
+	return false;
+}
+
+static void abox_ipc_trace_owner_release(void *arg)
+{
+	struct abox_ipc_trace_owner *owner = arg;
+	unsigned long flags;
+	bool removed;
+
+	spin_lock_irqsave(&abox_ipc_trace_owner_lock, flags);
+	removed = owner->registered &&
+		abox_ipc_trace_owner_unlink_locked(owner);
+	spin_unlock_irqrestore(&abox_ipc_trace_owner_lock, flags);
+	if (removed)
+		synchronize_rcu();
+}
+
+static void abox_ipc_trace_owner_unregister_data(struct abox_data *data)
+{
+	struct abox_ipc_trace_owner *owner;
+	unsigned long flags;
+	bool removed = false;
+
+	spin_lock_irqsave(&abox_ipc_trace_owner_lock, flags);
+	owner = rcu_dereference_protected(abox_ipc_trace_owner_head, 1);
+	while (owner) {
+		if (owner->data == data) {
+			removed = abox_ipc_trace_owner_unlink_locked(owner);
+			break;
+		}
+		owner = rcu_dereference_protected(owner->next, 1);
+	}
+	spin_unlock_irqrestore(&abox_ipc_trace_owner_lock, flags);
+	if (removed)
+		synchronize_rcu();
+}
+
+static int abox_ipc_trace_owner_register(struct device *dev,
+		struct abox_data *data)
+{
+	struct abox_ipc_trace_owner *owner;
+	struct abox_ipc_trace_owner *existing;
+	unsigned long flags;
+	int ret;
+
+	owner = devm_kzalloc(dev, sizeof(*owner), GFP_KERNEL);
+	if (!owner)
+		return -ENOMEM;
+	owner->data = data;
+	ret = devm_add_action_or_reset(dev, abox_ipc_trace_owner_release,
+			owner);
+	if (ret)
+		return ret;
+
+	spin_lock_irqsave(&abox_ipc_trace_owner_lock, flags);
+	for (existing = rcu_dereference_protected(
+			abox_ipc_trace_owner_head, 1);
+			existing;
+		existing = rcu_dereference_protected(existing->next, 1)) {
+		if (existing->data == data) {
+			spin_unlock_irqrestore(&abox_ipc_trace_owner_lock, flags);
+			return -EEXIST;
+		}
+	}
+	owner->registered = true;
+	rcu_assign_pointer(owner->next,
+			rcu_access_pointer(abox_ipc_trace_owner_head));
+	rcu_assign_pointer(abox_ipc_trace_owner_head, owner);
+	spin_unlock_irqrestore(&abox_ipc_trace_owner_lock, flags);
+
+	return 0;
+}
+
