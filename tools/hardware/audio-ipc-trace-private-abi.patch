 }
 
-static int abox_ipc_queue_get(struct abox_data *data, struct abox_ipc *ipc)
+static int abox_ipc_queue_get(struct abox_data *data, struct abox_ipc *ipc,
+		u64 *trace_seq)
 {
 	spinlock_t *lock = &data->ipc_queue_lock;
