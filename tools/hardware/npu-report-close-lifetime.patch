+/* The report owner pin is initialized once and is never reset by probe. */
+static DEFINE_SPINLOCK(report_owner_lock);
+static DECLARE_WAIT_QUEUE_HEAD(report_owner_wait);
+/* One reference is held by publication; readers take and drop extra refs. */
+static refcount_t report_owner_refs = REFCOUNT_INIT(0);
+static volatile struct mailbox_hdr *report_owner;
+
+static volatile struct mailbox_hdr *npu_report_owner_get(void)
+{
+	unsigned long flags;
+	volatile struct mailbox_hdr *owner;
+	spin_lock_irqsave(&report_owner_lock, flags);
+	owner = report_owner;
+	if (owner && !refcount_inc_not_zero(&report_owner_refs))
+		owner = NULL;
+	spin_unlock_irqrestore(&report_owner_lock, flags);
+	return owner;
+}
+
+static void npu_report_owner_put(void)
+{
+	if (refcount_dec_and_test(&report_owner_refs))
+		wake_up_all(&report_owner_wait);
+}
+
+static int npu_report_owner_publish(volatile struct mailbox_hdr *owner)
+{
+	unsigned long flags;
+	int ret = 0;
+	if (!owner)
+		return -EINVAL;
+	spin_lock_irqsave(&report_owner_lock, flags);
+	if (report_owner || refcount_read(&report_owner_refs))
+		ret = -EBUSY;
+	else {
+		refcount_set(&report_owner_refs, 1);
+		report_owner = owner;
+	}
+	spin_unlock_irqrestore(&report_owner_lock, flags);
+	return ret;
+}
+
+/* Detach first; wait without holding the spinlock so pinned readers can exit. */
+static volatile struct mailbox_hdr *npu_report_owner_detach(void)
+{
+	unsigned long flags;
+	volatile struct mailbox_hdr *owner;
+	bool wake_readers = false;
+	spin_lock_irqsave(&report_owner_lock, flags);
+	owner = report_owner;
+	report_owner = NULL;
+	if (owner)
+		wake_readers = refcount_dec_and_test(&report_owner_refs);
+	spin_unlock_irqrestore(&report_owner_lock, flags);
+	if (wake_readers)
+		wake_up_all(&report_owner_wait);
+	wait_event(report_owner_wait, !refcount_read(&report_owner_refs));
+	return owner;
+}
