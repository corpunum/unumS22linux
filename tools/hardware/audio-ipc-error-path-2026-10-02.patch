@@ -567,8 +570,10 @@ static int abox_ipc_queue_put(struct abox_data *data, struct device *dev,
 		if (trace_seq || ipc->trace_seq)
 			ipc->trace_seq = trace_seq;
 		memcpy(&ipc->msg, msg, size);
 		ipc->size = size;
 		data->ipc_queue_end = (data->ipc_queue_end + 1) % length;
