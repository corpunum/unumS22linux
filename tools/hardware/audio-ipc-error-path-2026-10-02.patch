+				&duplicate);
+		if (duplicate)
+			break;
 		if (trace_seq && trace_abox_pcm_trigger_queue_enabled())
 			trace_abox_pcm_trigger_queue(trace_seq, ktime_get_ns(),
 					msg->ipcid, msg->msg.pcmtask.channel_id,
 					msg->msg.pcmtask.msgtype, ret, retry,
 					atomic, sync);
 		queue_work(data->ipc_workqueue, &data->ipc_work);
@@ -718,6 +726,6 @@ int abox_request_ipc(struct device *dev,
 	} else {
 		ret = abox_schedule_ipc(dev, data, hw_irq, msg, size,
-				!!atomic, !!sync);
+				!!atomic, !!sync, NULL, false);
 	}
 
 	return ret;
@@ -727,6 +736,26 @@ int abox_request_ipc(struct device *dev,
 }
 EXPORT_SYMBOL(abox_request_ipc);
 
+int abox_request_pcm_trigger_ipc(struct device *dev, int channel,
+		bool atomic, bool *enabled, bool start)
+{
+	struct abox_data *data;
+	ABOX_IPC_MSG msg = { 0 };
+
+	if (!enabled)
+		return -EINVAL;
+
+	data = dev_get_drvdata(dev);
+	msg.ipcid = IPC_PCMPLAYBACK;
+	msg.task_id = channel;
+	msg.msg.pcmtask.msgtype = PCM_PLTDAI_TRIGGER;
+	msg.msg.pcmtask.channel_id = channel;
+	msg.msg.pcmtask.param.trigger = start;
+
+	return abox_schedule_ipc(dev, data, msg.ipcid, &msg, sizeof(msg),
+			!!atomic, false, enabled, start);
+}
+
 bool abox_is_on(void)
 {
 	return p_abox_data && p_abox_data->enabled;
