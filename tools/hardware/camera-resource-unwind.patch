diff --git a/drivers/media/platform/exynos/camera/is-resourcemgr.c b/drivers/media/platform/exynos/camera/is-resourcemgr.c
--- a/drivers/media/platform/exynos/camera/is-resourcemgr.c
+++ b/drivers/media/platform/exynos/camera/is-resourcemgr.c
@@ -1757,6 +1757,46 @@ static void is_resource_clear(struct is_resourcemgr *resourcemgr)
 #endif
 }
 
+static int is_resource_enable_phy_ldos(struct is_resourcemgr *resourcemgr)
+{
+	int i, j, failed_index, enable_ret, disable_ret, rollback_ret = 0;
+
+	for (i = 0; i < resourcemgr->num_phy_ldos; i++) {
+		enable_ret = regulator_enable(resourcemgr->phy_ldos[i]);
+		if (enable_ret) {
+			err("failed to enable PHY LDO[%d]: %d", i, enable_ret);
+			failed_index = i;
+
+			/* Roll back only the votes acquired by this attempt. */
+			for (j = failed_index - 1; j >= 0; j--) {
+				disable_ret = regulator_disable(resourcemgr->phy_ldos[j]);
+				if (disable_ret) {
+					err("failed to roll back PHY LDO[%d]: %d",
+						j, disable_ret);
+					if (!rollback_ret)
+						rollback_ret = disable_ret;
+				}
+				usleep_range(1000, 1001);
+			}
+
+			if (rollback_ret)
+				err("PHY LDO rollback incomplete after enable error %d; "
+					"rollback error %d, hardware state unknown",
+					enable_ret, rollback_ret);
+			else
+				err("prior PHY LDO votes rolled back; failing LDO[%d] "
+					"hardware state after error %d is unknown",
+					failed_index, enable_ret);
+
+			return enable_ret;
+		}
+
+		usleep_range(100, 101);
+	}
+
+	return 0;
+}
+
 int is_resource_get(struct is_resourcemgr *resourcemgr, u32 rsc_type)
 {
 	int ret = 0;
@@ -1765,6 +1805,9 @@ int is_resource_get(struct is_resourcemgr *resourcemgr, u32 rsc_type)
 	struct is_resource *resource;
 	struct is_core *core;
 	int i, id;
+#ifdef ENABLE_DYNAMIC_MEM
+	int cleanup_ret;
+#endif
 
 	FIMC_BUG(!resourcemgr);
 	FIMC_BUG(!resourcemgr->private_data);
@@ -1846,13 +1889,10 @@ int is_resource_get(struct is_resourcemgr *resourcemgr, u32 rsc_type)
 		}
 #endif
 
-		for (i = 0; i < resourcemgr->num_phy_ldos; i++) {
-			ret = regulator_enable(resourcemgr->phy_ldos[i]);
-			if (ret) {
-				err("failed to enable PHY LDO[%d]", i);
-				goto p_err;
-			}
-			usleep_range(100, 101);
+		ret = is_resource_enable_phy_ldos(resourcemgr);
+		if (ret) {
+			err("first-resource PHY LDO setup failed: %d", ret);
+			goto err_first_resource_phy_ldo;
 		}
 	}
 
@@ -1975,6 +2015,21 @@ int is_resource_get(struct is_resourcemgr *resourcemgr, u32 rsc_type)
 		is_camif_wdma_init();
 	}
 
+	goto p_err;
+
+err_first_resource_phy_ldo:
+#ifdef ENABLE_DYNAMIC_MEM
+	cleanup_ret = is_resourcemgr_deinit_dynamic_mem(resourcemgr);
+	if (cleanup_ret) {
+		err("dynamic memory cleanup after PHY LDO failure: %d",
+			cleanup_ret);
+	}
+#endif
+	is_resource_clear(resourcemgr);
+	pm_relax(&core->pdev->dev);
+	/* Do not increment resource/core counts for a failed first acquire. */
+	goto rsc_err;
+
 p_err:
 	atomic_inc(&resource->rsccount);
 	atomic_inc(&core->rsccount);
