[Unit]
Description=Owner-voice TTS (voxcpm-greek :8890) on the Tailscale address for the S22 phone
After=network-online.target tailscaled.service voxcpm-greek.service
Wants=network-online.target

[Service]
Type=simple
# S22_RIG_HOST (the rig's Tailscale IPv4) lives in the untracked local.env that install-rig.sh writes.
EnvironmentFile=%h/.config/s22-linux/local.env
ExecStartPre=/bin/sh -c 'test -n "$S22_RIG_HOST" || exit 1; for i in $(seq 30); do ip -4 addr show tailscale0 2>/dev/null | grep -qF " $S22_RIG_HOST/" && exit 0; sleep 2; done; exit 1'
# Installed copy of tools/hardware/voice/rig/tcp-forward.py (s22-linux).
ExecStart=/usr/bin/python3 -I -B %h/.local/lib/s22-voice/tcp-forward.py ${S22_RIG_HOST}:8890 127.0.0.1:8890
MemoryMax=128M
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
