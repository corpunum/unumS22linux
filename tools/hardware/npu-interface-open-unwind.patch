 static struct workqueue_struct *wq;
 static struct work_struct work_report;
+static DEFINE_SPINLOCK(report_wq_lock);
+static DEFINE_MUTEX(report_wq_lifecycle_lock);
+static int report_irq_count;
+static int report_affinity_count;
+static bool report_interface_probed;
+static bool report_interface_open;
+
+/* Queue producers run in both hardirq and process context. */
+static void npu_report_queue_work(void)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&report_wq_lock, flags);
+	if (wq)
+		queue_work(wq, &work_report);
+	spin_unlock_irqrestore(&report_wq_lock, flags);
+}
+
+static void npu_report_workqueue_install(struct workqueue_struct *queue)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&report_wq_lock, flags);
+	wq = queue;
+	spin_unlock_irqrestore(&report_wq_lock, flags);
+}
+
+static struct workqueue_struct *npu_report_workqueue_detach(void)
+{
+	unsigned long flags;
+	struct workqueue_struct *queue;
+
+	spin_lock_irqsave(&report_wq_lock, flags);
+	queue = wq;
+	wq = NULL;
+	spin_unlock_irqrestore(&report_wq_lock, flags);
+	return queue;
+}
+
+/* Call only after detaching the queue from every producer. */
+static void npu_report_workqueue_destroy(struct workqueue_struct *queue)
+{
+	if (!queue)
+		return;
+	flush_workqueue(queue);
+	destroy_workqueue(queue);
+}
 
