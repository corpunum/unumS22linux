diff --git a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
index 0bc14ed..66bbed5 100644
--- a/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
+++ b/src/amd/vulkan/winsys/amdgpu/radv_amdgpu_bo.c
@@ -312,8 +312,12 @@ radv_amdgpu_winsys_bo_destroy(struct radeon_winsys *_ws, struct radeon_winsys_bo
       free(bo->ranges);
       u_rwlock_destroy(&bo->lock);
    } else {
-      if (bo->cpu_map)
-         munmap(bo->cpu_map, bo->base.size);
+      if (bo->cpu_map) {
+         /* cpu_map is acquired through libdrm; pair it with its unmap API
+          * before freeing the BO rather than bypassing libdrm bookkeeping. */
+         amdgpu_bo_cpu_unmap(bo->bo);
+         bo->cpu_map = NULL;
+      }
 
       if (ws->debug_all_bos)
          radv_amdgpu_global_bo_list_del(ws, bo);
@@ -572,9 +576,11 @@ radv_amdgpu_winsys_bo_unmap(struct radeon_winsys *_ws, struct radeon_winsys_bo *
 
    assert(bo->cpu_map);
    if (replace) {
+      /* Keep the fixed-address reservation after releasing libdrm's map. */
+      amdgpu_bo_cpu_unmap(bo->bo);
       (void)mmap(bo->cpu_map, bo->base.size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
    } else {
-      munmap(bo->cpu_map, bo->base.size);
+      amdgpu_bo_cpu_unmap(bo->bo);
    }
    bo->cpu_map = NULL;
 }
