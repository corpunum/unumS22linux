{
  "name": "s22-ui",
  "version": "0.1.0",
  "type": "tool",
  "entrypoint": "index.mjs",
  "description": "Samsung S22 native-Linux touch UI: the same action surface the owner uses (open app, home, notification card, ask-to-confirm, keyboard, screen/lock, screenshot) over s22-touchd.",
  "capabilities": ["ui_open_app", "ui_home", "ui_show_card", "ui_confirm", "ui_keyboard", "ui_screen", "ui_state", "ui_screenshot"],
  "dependencies": [],
  "config": {
    "socket_path": "/run/s22-touch/ctl.sock",
    "run_dir": "/run/s22-touch",
    "request_timeout_ms": 20000,
    "untrusted_session_id": "phone:untrusted",
    "screenshot_dir": "/tmp",
    "wayland_display": "wayland-1",
    "xdg_runtime_dir": "/run/user/0"
  }
}
